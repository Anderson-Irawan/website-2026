# ==========================================================================
#  Double Dash Creative - Apache config (cPanel)
# ==========================================================================

Options -Indexes +FollowSymLinks
DirectoryIndex index.html

# --------------------------------------------------------------------------
#  Clean URLs
# --------------------------------------------------------------------------
RewriteEngine On

# /index.html  and  /index   ->   /
RewriteCond %{THE_REQUEST} \s/+index(?:\.html)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# /page.html   ->   /page   (301, so there's one canonical URL)
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# /page   ->   serve page.html  (internal, only if the file exists)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# --------------------------------------------------------------------------
#  Compression
# --------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
        text/javascript application/javascript application/json \
        image/svg+xml application/xml application/rss+xml
</IfModule>

# --------------------------------------------------------------------------
#  Caching  (fingerprint / rename assets when you change them)
# --------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On

    ExpiresByType text/html                "access plus 0 seconds"

    ExpiresByType text/css                 "access plus 1 year"
    ExpiresByType application/javascript   "access plus 1 year"
    ExpiresByType text/javascript          "access plus 1 year"

    ExpiresByType image/jpeg               "access plus 1 year"
    ExpiresByType image/png                "access plus 1 year"
    ExpiresByType image/gif                "access plus 1 year"
    ExpiresByType image/webp               "access plus 1 year"
    ExpiresByType image/svg+xml            "access plus 1 year"
    ExpiresByType image/x-icon             "access plus 1 year"

    ExpiresByType video/mp4                "access plus 1 year"
    ExpiresByType video/webm               "access plus 1 year"

    ExpiresByType font/woff2               "access plus 1 year"
    ExpiresByType font/woff                "access plus 1 year"
    ExpiresByType application/font-woff2   "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|svg|ico|mp4|webm|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# --------------------------------------------------------------------------
#  Small hardening
# --------------------------------------------------------------------------
<Files ".htaccess">
    Require all denied
</Files>
