# ==========================================================================
#  Double Dash Creative - Apache config (cPanel)
# ==========================================================================

Options -Indexes +FollowSymLinks
DirectoryIndex index.html

# --------------------------------------------------------------------------
#  Clean URLs
# --------------------------------------------------------------------------
RewriteEngine On

# --------------------------------------------------------------------------
#  One canonical origin: https, no www
#
#  Sanity's CORS allowlist is per-origin, and it holds the https addresses
#  only. Served over http:// the browser treats the page as a different
#  origin and blocks every content request, so the grids come up empty.
#  That is what happens in Instagram's in-app browser, which lands on http.
# --------------------------------------------------------------------------
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://doubledashcreative.com%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# /index.html  and  /index   ->   /
RewriteCond %{THE_REQUEST} \s/+index(?:\.html)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# /page.html   ->   /page   (301, so there's one canonical URL)
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# /page   ->   serve page.html  (internal, only if the file exists)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# --------------------------------------------------------------------------
#  Compression
# --------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
        text/javascript application/javascript application/json \
        image/svg+xml application/xml application/rss+xml
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(html|csv)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# --------------------------------------------------------------------------
#  Small hardening
# --------------------------------------------------------------------------
<Files ".htaccess">
    Require all denied
</Files>
